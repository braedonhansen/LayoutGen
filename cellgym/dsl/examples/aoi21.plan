cell aoi21
in A B C
out OUT
col 0 sd n=VSS*  p=p1*
col 1 g  n=B     p=B
col 2 sd n=n1    p=VDD*
col 3 g  n=A     p=A
col 4 sd n=OUT*  p=p1*
col 5 g  n=C     p=C
col 6 sd n=VSS*  p=OUT*
route p1  met1 p0 pmos:0 pmos:4
route OUT li1  c1 nmos:4 pmos:6
pin A gate:3 c2
pin B gate:1 c0
pin C gate:5 c0
pin OUT nmos:4
